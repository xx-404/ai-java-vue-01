<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mars.system.mapper.SysUserTempMenuMapper">

    <delete id="deleteByUserId">
        DELETE FROM sys_user_temp_menu WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByMenuId">
        DELETE FROM sys_user_temp_menu WHERE menu_id = #{menuId}
    </delete>

</mapper>
